  "description": "Nông nghiệp nhiệt đới WordPress theme (Vue 3 + Tailwind + Vite + ACF).",
  "author": "Tuan Vo",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
